    def create_invited_user(self):
        first_name = self.random_name("first")
        last_name = self.random_name("last")
        password = "Tha cha 098!"

        first_name_input = self.mail_wait.until(EC.element_to_be_clickable(self.FIRST_NAME_INPUT))
        self.set_input_value(first_name_input, first_name, driver=self.mail_driver)

        last_name_input = self.mail_wait.until(EC.element_to_be_clickable(self.LAST_NAME_INPUT))
