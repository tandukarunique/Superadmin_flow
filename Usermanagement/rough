            print("[captcha] ⚠️ reCAPTCHA solving failed, attempting to continue...")

        # Click create user button
        self.mail_wait.until(EC.element_to_be_clickable(self.CREATE_USER_BTN)).click()
        print(f"[email] ✅ Created invited user: {first_name} {last_name}")
        sleep(2)